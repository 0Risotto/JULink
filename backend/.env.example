# Copy to .env for local development. Never commit real secrets.

JULINK_ENV=dev
LOG_FORMAT=pretty
RUST_LOG=info,tower_http=info

CORS_ORIGINS=http://localhost:3000
DEV_AUTH=true
RUN_MIGRATIONS=true
# NATS_URL=nats://localhost:4223

# ---- identity ----
PORT=9000
DATABASE_URL=postgres://julink:julink@localhost:5434/julink_identity
JWT_ISSUER=julink
JWT_TTL_SECONDS=900
# Optional PEM-encoded Ed25519 private key. If unset, identity generates an ephemeral key.
# JWT_PRIVATE_KEY_PEM=

# ---- auth ----
REFRESH_TTL_SECONDS=2592000
COOKIE_NAME=julink_refresh
COOKIE_PATH=/api/v1/auth
# COOKIE_SECURE=true
OTP_SECRET=replace-with-a-long-random-secret
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Returns the OTP in API responses for local testing. Never enable in production.
DEV_OTP=true

# ---- email ----
# Leave SMTP_HOST empty to log OTPs instead of sending email (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=JULink <no-reply@julink.local>

# ---- gateway ----
# PORT=8080
IDENTITY_URL=http://localhost:9000
SOCIAL_URL=http://localhost:9001
CONTENT_URL=http://localhost:9002
FEED_URL=http://localhost:9003
SEARCH_URL=http://localhost:9004
MESSAGING_URL=http://localhost:9005
REALTIME_WS_URL=ws://localhost:9006/ws
CALLS_URL=http://localhost:9007
COMMUNITY_URL=http://localhost:9008
NOTIFICATIONS_URL=http://localhost:9009
# Optional public key PEM. Otherwise the gateway fetches it from identity.
# JWT_PUBLIC_KEY_PEM=

# ---- social ----
SOCIAL_DATABASE_URL=postgres://julink:julink@localhost:5434/julink_social
NEO4J_URI=bolt://localhost:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=julinkdev
IDENTITY_URL=http://localhost:9000
NATS_URL=nats://localhost:4223

# ---- content ----
CONTENT_DATABASE_URL=postgres://julink:julink@localhost:5434/julink_content

# ---- feed ----
FEED_CACHE_TTL_SECONDS=60

# ---- search ----
SEARCH_DATABASE_URL=postgres://julink:julink@localhost:5434/julink_search
SYNC_INTERVAL_SECONDS=60
SYNC_ENABLED=true

# ---- messaging ----
MESSAGING_DATABASE_URL=postgres://julink:julink@localhost:5434/julink_messaging

# ---- realtime ----
REALTIME_URL=http://localhost:9006
TICKET_TTL_SECONDS=30

# ---- calls ----
CALLS_DATABASE_URL=postgres://julink:julink@localhost:5434/julink_calls
JITSI_BASE_URL=https://meet.jit.si

# ---- community ----
COMMUNITY_DATABASE_URL=postgres://julink:julink@localhost:5434/julink_community

# ---- notifications ----
NOTIFICATIONS_DATABASE_URL=postgres://julink:julink@localhost:5434/julink_notifications
