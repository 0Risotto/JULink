            OR LOWER(u.first_name) LIKE LOWER(CONCAT('%', ?, '%'))     
            OR LOWER(u.last_name) LIKE LOWER(CONCAT('%', ?, '%'))     
            OR LOWER(u.email) LIKE LOWER(CONCAT('%', ?, '%'))     
            OR LOWER(u.college) LIKE LOWER(CONCAT('%', ?, '%'))     
            OR u.username % ?     
            OR u.first_name % ?     
            OR u.last_name % ?     
            OR u.email % ?     
            OR u.college % ? 
        ) 
    ORDER BY
        GREATEST(     similarity(u.username, ?),     similarity(u.first_name, ?),     similarity(u.last_name, ?),     similarity(u.email, ?),     similarity(u.college, ?) ) DESC,
        u.username ASC 
    fetch
        first ? rows only 
