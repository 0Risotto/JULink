Hibernate: 
    SELECT
        * 
    FROM
        users u 
    WHERE
        (
            ? IS NULL 
            OR u.id <> ?
        ) 
        AND (
            LOWER(u.username) LIKE LOWER(CONCAT('%', ?, '%'))     
            OR LOWER(u.first_name) LIKE LOWER(CONCAT('%', ?, '%'))     
            OR LOWER(u.last_name) LIKE LOWER(CONCAT('%', ?, '%'))     
            OR LOWER(u.email) LIKE LOWER(CONCAT('%', ?, '%'))     
            OR LOWER(u.college) LIKE LOWER(CONCAT('%', ?, '%'))     
            OR u.username % ?     
            OR u.first_name % ?     
            OR u.last_name % ?     
            OR u.email % ?     
            OR u.college % ? 
        ) 
    ORDER BY
